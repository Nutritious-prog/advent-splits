# ─── Database (Supabase → Project Settings → Database → Connection string → Transaction pooler, port 6543)
# Leave empty locally to use the embedded PGlite database in ./.data
DATABASE_URL=

# ─── Sessions & admin
# Long random string, e.g. `openssl rand -base64 48`
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_PASSWORD=change-me

# ─── Event configuration
ADVENT_START=2026-12-01
ADVENT_DAYS=24
ADVENT_TZ=Europe/Warsaw
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_INSTAGRAM_HANDLE=wlod_run

# ─── Local development only (ignored when NODE_ENV=production)
# Pretend the server clock is at this instant, e.g. 2026-12-05T10:00:00+01:00
DEV_NOW=

# Test mode (pretend it is a chosen advent day). Always on in local development.
# Outside development it needs ENABLE_TEST_MODE=true AND an admin session (log in at /admin first).
# Only for a staging deployment with its own database, never for production.
ENABLE_TEST_MODE=

# Shown on /prywatnosc (privacy policy). REQUIRED in production: the build fails without them
# (strict mode = Vercel production deploys, or REQUIRE_PROD_CONFIG=true on other hosts).
# NEXT_PUBLIC_SITE_URL is required too and must be https:// and not localhost.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
